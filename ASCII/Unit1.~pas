procedure TForm1.BitBtn2Click(Sender: TObject);
const
 xlHAlignCenter=-4108;
 xlVAlignCenter=-4108;
var app: variant;
    i,j: integer;
    r,c: integer;
begin
 try
    //проверяем, нет ли запущенного Excel
    app := GetActiveOleObject('Excel.Application');
    app.Quit;
  except
    //если нет, то запускаем
    on EOLESysError do
     begin
      app := CreateOleObject('Excel.Application');
      app:= GetActiveOleObject('Excel.Application');
     end;
  end;
 app.WorkBooks.Add;
 Gauge1.MaxValue:=255;
 r:= 0; c:= 0;
 for i:= 0 to 16 do
  for j:= 0 to 16 do
   begin
    app.Worksheets.Item['Лист1'].cells[i+1,j+1].Value:=trim(sg.Cells[j,i]);
    app.Worksheets.Item['Лист1'].cells[i+1,j+1].horizontalalignment:=xlHAlignCenter;
    app.Worksheets.Item['Лист1'].cells[i+1,j+1].verticalalignment:=xlVAlignCenter;
    Gauge1.Progress:=Gauge1.Progress+1;
   end;
 app.visible:=true;
 Gauge1.Progress:=0;
end;

